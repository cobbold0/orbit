# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase PostgreSQL (Prisma)
# Use Transaction Pooler (port 6543 with ?pgbouncer=true) for DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit?schema=public"
# Use Session Pooler or Direct Connection (port 5432) for DIRECT_URL (migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/orbit?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32-byte-high-entropy-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Primary AI Provider (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Secondary Home-Lab Model (Non-conversational narrow tasks only)
HOMELAB_AI_ENABLED="false"
HOMELAB_AI_BASE_URL=""
HOMELAB_AI_API_KEY=""

# Inngest Durable Workflows
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:orbit@example.com"
